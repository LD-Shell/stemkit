{
  "name": "stemkit-core",
  "version": "0.3.0",
  "description": "Dependency-injected computational core for STEMKit: GROMACS, PLUMED and LAMMPS input writing and checking, trajectory parsing, statistics, molecular structure geometry, curve fitting, unit conversion, and HPC script generation.",
  "type": "module",
  "main": "src/core/index.js",
  "exports": {
    ".": {
      "node": "./src/core/node.js",
      "default": "./src/core/index.js"
    },
    "./*": "./src/core/*.js"
  },
  "files": [
    "src/core",
    "js/dependencies/package.json",
    "js/dependencies/LICENSES.md",
    "js/dependencies/jstat.min.js",
    "js/dependencies/papaparse.min.js",
    "js/dependencies/regression.min.js",
    "js/dependencies/bibtexParse.min.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "prepublishOnly": "npm test && node tests/smoke.mjs",
    "check:links": "node tools/check-links.mjs",
    "check:links:internal": "node tools/check-links.mjs --internal-only",
    "check:chrome": "node tools/check-chrome.mjs",
    "check:plumed": "node tools/check-plumed-parse.mjs",
    "check:gromacs": "node tools/check-gromacs-grompp.mjs",
    "check:ndx": "node tools/check-gromacs-ndx.mjs",
    "check:lammps": "node tools/check-lammps.mjs",
    "check:lammps-data": "node tools/check-lammps-data.mjs",
    "check:lammps-workflow": "node tools/check-lammps-workflow.mjs",
    "build:gromacs-mdp": "node tools/build-gromacs-mdp.mjs",
    "build:plumed-syntax": "node tools/build-plumed-syntax.mjs",
    "build:lammps-docs": "node tools/build-lammps-docs.mjs",
    "check:lammps-docs": "node tools/build-lammps-docs.mjs --check",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind/input.css -o src/output.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/tailwind/input.css -o src/output.css --watch",
    "build:sitemap": "node tools/build-sitemap.mjs",
    "check:sitemap": "node tools/build-sitemap.mjs --check",
    "build:csp": "node tools/build-csp.mjs",
    "check:csp": "node tools/build-csp.mjs --check"
  },
  "keywords": [
    "computational-chemistry",
    "molecular-dynamics",
    "gromacs",
    "plumed",
    "lammps",
    "xvg",
    "statistics",
    "curve-fitting",
    "slurm",
    "open-science",
    "client-side",
    "privacy"
  ],
  "author": "Olanrewaju M. Daramola",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LD-Shell/stemkit.git"
  },
  "bugs": {
    "url": "https://github.com/LD-Shell/stemkit/issues"
  },
  "homepage": "https://stemkit.net",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "tailwindcss": "^3.4.19"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/core/**/*.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/lammps/",
      "<rootDir>/plumed2/",
      "<rootDir>/gromacs-2025.1/",
      "<rootDir>/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/lammps/",
      "<rootDir>/plumed2/",
      "<rootDir>/gromacs-2025.1/",
      "<rootDir>/.claude/"
    ]
  }
}
